#!/usr/bin/env node

const usage=(`
    Usage: hebrew-grep [regular-expression] [one or more files and folders...]

    Usage examples:
      - Find the *whole* word "נחש" in a Perush file (notice how we wrap "נחש" with spaces):
          hebrew-grep ' נחש ' פירוש/1-בראשית/1030-בראשית-ב_יח-ג_כד-אדם_ואשה.rtl.md
      - Find any word that includes "נ" then "ח" then "ש", in the whole book of Genesis (folders are searched recursively):
          hebrew-grep 'נ[^ ]*ח[^ ]*ש' פירוש/1-בראשית

    When searching a line in a file:
      - The search ignores Hebrew nikud (Punctuation)
      - The search treats all non-Hebrew-sequences as a single space
      - Space is added before the first line, and after the last line
    The result: the search only see space-delimited list of Hebrew words (every word has a single space in both ends).

    The same normalizations are applied to the regular-expression's Hebrew letters, and in addition (to both):
      - Final letters are treated as regular letters: 'ךםןףץ' is the same as 'כמנפצ' ('ארץ' also finds 'ארצות').
      - Shin: a plain 'ש' matches every Shin (undotted, Shin-dot 'שׁ' and Sin-dot 'שׂ'),
        while a dotted 'שׁ' or 'שׂ' matches only Shins with that same dot.
        (Either way - the precomposed and the decomposed Unicode forms are the same.)

    The output is YAML like, following this format:

    - file-path
      - line-number: [book perek:pasuk]<`+`tab>full-matched-line
      - ...
    - file-path
      - ...
      - ...

    Full example:
       hebrew-grep 'נ[^ ]*ח[^ ]*ש' פירוש/1-בראשית
       - פירוש/1-בראשית/1030-בראשית-ב_יח-ג_כד-אדם_ואשה.rtl.md
         - 77: [בראשית ג:א]	> בראשית ג א: וְהַנָּחָשׁ הָיָה עָרוּם מִכֹּל חַיַּת הַשָּׂדֶה אֲשֶׁר עָשָׂה יְהוָה אֱלֹהִים; וַיֹּאמֶר אֶל הָאִשָּׁה אַף כִּי אָמַר אֱלֹהִים לֹא תֹאכְלוּ מִכֹּל עֵץ הַגָּן.
         - 101: [בראשית ג:ג]	האישה מוצאת את עצמה במציאות שבה מסוכן להיות עירומה וללא מחיצות (לזרום עם הנחש) ומסוכן לאכול כל תובנה בחופשיות (לאכול מעץ החיים).
`).replace(/\n    /g, '\n').trim()

const fs = require('fs')
const path = require('path')

// Hebrew nikud (vowel points, cantillation marks, Shin/Sin dots, varika) and invisible joiners (CGJ, ZWNJ, ZWJ) —
// excludes maqaf (U+05BE), paseq (U+05C0), sof pasuq (U+05C3), nun hafukha (U+05C6) so they act as word separators.
const NIKUD = '\\u0591-\\u05BD\\u05BF\\u05C1\\u05C2\\u05C4\\u05C5\\u05C7\\uFB1E\\u034F\\u200C\\u200D'
const NIKUD_RE = new RegExp(`[${NIKUD}]`, 'g')

// A Shin with all the nikud marks attached to it (after NFD - the Shin/Sin dot may come after other marks).
const SHIN_WITH_NIKUD_RE = new RegExp(`ש([${NIKUD}]*)`, 'g')

// Private-use characters that stand for a dotted Shin / Sin in normalized text.
const SHIN_DOT = ''
const SIN_DOT  = ''

// Hebrew letters: alef (U+05D0) through tav (U+05EA), plus the dotted Shin / Sin above
const NON_HEBREW_RE = new RegExp(`[^\\u05D0-\\u05EA${SHIN_DOT}${SIN_DOT}]+`, 'g')

const FINALS = { 'ך': 'כ', 'ם': 'מ', 'ן': 'נ', 'ף': 'פ', 'ץ': 'צ' }
const FINALS_RE = /[ךםןףץ]/g

// Verse quote line: > book chapter verse: ...
const VERSE_RE = /^>\s*(\S+)\s+(\S+)\s+(\S+)\s*:/

/**
 * Normalize the Hebrew letters of a string (text or regexp): decompose precomposed letters, mark dotted Shins,
 * remove nikud, and replace final letters with regular letters. Non-Hebrew characters are left untouched.
 */
function normalizeHebrewLetters(str) {
  return str
    .normalize('NFD')
    .replace(SHIN_WITH_NIKUD_RE, (_whole, marks) =>
      marks.includes('ׁ') ? SHIN_DOT :
      marks.includes('ׂ') ? SIN_DOT  :
      'ש')
    .replace(NIKUD_RE, '')
    .replace(FINALS_RE, letter => FINALS[letter])
}

function normalizeForSearch(line) {
  return ' ' + normalizeHebrewLetters(line).replace(NON_HEBREW_RE, ' ') + ' '
}

/**
 * Normalize the regexp's Hebrew letters like the searched text, and make every plain 'ש' match all the Shin forms:
 * a plain 'ש' (or an escaped '\ש') outside a character class becomes a class of all the Shin forms,
 * and a character class that contains 'ש' (also within a range like 'א-ת') gets the dotted Shin forms added.
 */
function normalizePattern(pattern) {
  const normalized = normalizeHebrewLetters(
    pattern.replace(/\\u(05[0-9A-Fa-f]{2}|[Ff][Bb][0-9A-Fa-f]{2})/g, (_whole, hex) => String.fromCharCode(parseInt(hex, 16))))
  const allShins = `ש${SHIN_DOT}${SIN_DOT}`
  let result = ''
  for (let i = 0; i < normalized.length; i++) {
    const ch = normalized[i]
    if (ch === '\\' && normalized[i + 1] === 'ש') {
      result += `[${allShins}]`
      i++
    } else if (ch === '\\') {
      result += ch + (normalized[i + 1] ?? '')
      i++
    } else if (ch === 'ש') {
      result += `[${allShins}]`
    } else if (ch === '[') {
      const end = findClassEnd(normalized, i)
      result += normalizeClass(normalized.slice(i, end))
      i = end - 1
    } else {
      result += ch
    }
  }
  return result
}

/** Return the index just after the character class that starts at `start` (or the pattern's length). */
function findClassEnd(pattern, start) {
  for (let i = start + 1; i < pattern.length; i++) {
    if (pattern[i] === '\\') i++
    else if (pattern[i] === ']') return i + 1
  }
  return pattern.length
}

/** Add the dotted Shin forms to a character class (e.g. '[^א-ת]') that covers 'ש'. */
function normalizeClass(charClass) {
  const closed = charClass.endsWith(']')
  const body = charClass.slice(1, closed ? -1 : undefined)
  const negated = body.startsWith('^')
  const atoms = []                                        // the class' body - split to characters and escapes
  for (let i = negated ? 1 : 0; i < body.length; i++) {
    if (body[i] === '\\' && body[i + 1] === 'ש') {
      atoms.push('ש')
      i++
    } else if (body[i] === '\\') {
      atoms.push(body.slice(i, i + 2))
      i++
    } else {
      atoms.push(body[i])
    }
  }
  // Let JavaScript decide whether the (non-negated) class covers 'ש' - by a literal, a range or an escape.
  let coversShin = false
  try { coversShin = closed && new RegExp(`[${atoms.join('')}]`).test('ש') } catch {}
  if (coversShin) {
    // The added characters must not form a range with a trailing literal '-' (as in '[ש-]').
    const endsWithLiteralDash = atoms.at(-1) === '-' && atoms.at(-2) !== '-'
    atoms.splice(endsWithLiteralDash ? -1 : atoms.length, 0, SHIN_DOT + SIN_DOT)
  }
  return '[' + (negated ? '^' : '') + atoms.join('') + (closed ? ']' : '')
}

// Temporary local variants of Perush files (NNNN-book-from-to-title.<number>.rtl.md) - skipped when searching folders.
const PERUSH_VARIANT_RE = /\.\d+\.rtl\.md$/

function collectFiles(target) {
  let stat
  try { stat = fs.statSync(target) } catch { return [] }
  if (stat.isFile()) return [target]
  if (stat.isDirectory()) {
    const results = []
    for (const entry of fs.readdirSync(target, { recursive: true })) {
      const full = path.join(target, String(entry))
      if (PERUSH_VARIANT_RE.test(full)) continue
      try { if (fs.statSync(full).isFile()) results.push(full) } catch {}
    }
    return results.sort()
  }
  return []
}

function searchFile(filePath, regex) {
  let content
  try { content = fs.readFileSync(filePath, 'utf-8') } catch { return [] }
  const lines = content.split('\n')
  let currentRef = null
  const matches = []

  for (let i = 0; i < lines.length; i++) {
    const line = lines[i]
    const verseMatch = line.match(VERSE_RE)
    if (verseMatch) {
      currentRef = `${verseMatch[1]} ${verseMatch[2]}:${verseMatch[3]}`
    }
    const normalized = normalizeForSearch(line)
    if (regex.test(normalized)) {
      const ref = currentRef ? `[${currentRef}]` : ''
      matches.push({ lineNum: i + 1, ref, line: line.trimEnd() })
    }
  }
  return matches
}

// --- main ---

const args = process.argv.slice(2)
if (args.length < 2 || args.includes('--help') || args.includes('-h')) {
  console.log(usage)
  process.exit(args.length < 2 && !args.includes('--help') && !args.includes('-h') ? 1 : 0)
}

const pattern = args[0]
const targets = args.slice(1)

let regex
try {
  regex = new RegExp(normalizePattern(pattern))
} catch (e) {
  console.error(`Invalid regex: ${pattern}\n${e.message}`)
  process.exit(1)
}

const files = targets.flatMap(t => collectFiles(t))

for (const file of files) {
  const matches = searchFile(file, regex)
  if (matches.length > 0) {
    console.log(`- ${file}`)
    for (const m of matches) {
      console.log(`  - ${m.lineNum}: ${m.ref}\t${m.line}`)
    }
  }
}
