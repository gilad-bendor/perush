{
  // The server side: src/, the tests, the layout tools - written for Node's type stripping (erasable syntax only,
  // `.ts` on every relative import, `import type` for types). The browser code has its own: public/tsconfig.json.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"]
  },
  "include": ["src/**/*", "tests/**/*", "layout-guidelines/**/*", "playwright-test.ts"]
}
