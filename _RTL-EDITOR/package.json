{
  "name": "hebrew-markdown-editor",
  "version": "1.0.0",
  "description": "Hebrew Markdown RTL Editor with file browser",
  "scripts": {
    "kill-server": "lsof -ti:4000 | xargs kill -9 2>/dev/null || true",
    "dev": "bun run kill-server && bun --watch src/server.ts",
    "start": "bun run kill-server && bun run src/server.ts",
    "test": "bun test",
    "test:browser": "bun run playwright-test.ts",
    "rebuild-whole-html-folder": "bun run src/rebuild-whole-html-folder.ts",
    "claude-into-rtl-file": "scripts/claude-into-rtl-file.sh"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.1",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.11",
    "@lezer/highlight": "^1.2.3",
    "@types/bun": "^1.3.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.19.30",
    "codemirror": "^6.0.2",
    "playwright": "^1.58.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "bun": "^1.3.8",
    "markdown-it": "^15.0.2"
  }
}
