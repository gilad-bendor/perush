{
  "name": "hebrew-markdown-editor",
  "version": "1.0.0",
  "description": "Hebrew Markdown RTL Editor with file browser",
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "kill-server": "lsof -ti:4000 | xargs kill -9 2>/dev/null || true",
    "dev": "npm run kill-server && node --watch-path=src --watch-path=public/src src/server.ts",
    "start": "npm run kill-server && node src/server.ts",
    "test": "node --test --test-concurrency=1 'tests/**/*.test.ts' '../שונות/תרגומי-טקסטים-קדומים/layout/tests/*.test.ts'",
    "test:browser": "node playwright-test.ts",
    "check": "tsc --noEmit -p . && tsc --noEmit -p ../שונות/תרגומי-טקסטים-קדומים",
    "rebuild-whole-html-folder": "node src/rebuild-whole-html-folder.ts",
    "rows": "node ../שונות/תרגומי-טקסטים-קדומים/layout/rows-tool.ts",
    "layout-status": "node layout-guidelines/layout-status.ts"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.1",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "6.39.11",
    "@lezer/highlight": "^1.2.3",
    "@types/fontkit": "^2.0.9",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "codemirror": "^6.0.2",
    "patch-package": "^8.0.1",
    "playwright": "^1.58.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "fontkit": "2.0.4",
    "markdown-it": "^15.0.2",
    "pdf-lib": "^1.17.1"
  }
}
